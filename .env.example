# Copy to .env and fill in. Never commit .env - it holds your bot token.

# From @BotFather
BOT_TOKEN=
# The https address of your domain, without a trailing slash
PUBLIC_URL=https://example.com
# Telegram user ids of admins, comma separated (ask @userinfobot for yours)
ADMIN_IDS=

# Where the database and photos are stored (install.sh fills this in)
# DATA_DIR=/home/you/myapp-data/data

# Signs photo links. Any long random string; defaults to the bot token.
# SECRET_KEY=

# Local time for date stamps (5 = Tashkent, 3 = Moscow)
UTC_OFFSET_HOURS=5
MAX_PHOTOS=5

# 1 lets you open the app in a normal browser as /?dev=<telegram id>. Local testing only!
DEV_MODE=0
